# =================================================================
# BILLMINT SAAS PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# IMPORTANT: Copy this file to .env or .env.local and update the values.
# NEVER commit real credentials or private keys to git version control.

# Node Execution Environment & Port Config
NODE_ENV=development
PORT=5000

# -----------------------------------------------------------------
# CONFIDENTIAL DATABASE CREDENTIALS (MongoDB Atlas / Self-Hosted)
# -----------------------------------------------------------------
# Primary MongoDB Connection URI string with credentials
MONGODB_URI=mongodb+srv://admin_user:CONFIDENTIAL_PASSWORD@cluster0.billmint.mongodb.net/billmint_prod?retryWrites=true&w=majority
MONGODB_DB_NAME=billmint_production_db

# -----------------------------------------------------------------
# CONFIDENTIAL AUTHENTICATION & JWT SECURITY TOKENS
# -----------------------------------------------------------------
JWT_SECRET=billmint_sec_key_production_2026_super_private_auth_hash
JWT_EXPIRES_IN=7d
ADMIN_SECRET_KEY=billmint_super_admin_security_passkey_2026

# -----------------------------------------------------------------
# CONFIDENTIAL PAYMENT GATEWAY CREDENTIALS (Razorpay / Stripe)
# -----------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_billmint_key_id_987654
RAZORPAY_KEY_SECRET=confidential_razorpay_secret_key_123456
RAZORPAY_WEBHOOK_SECRET=whsec_billmint_razorpay_webhook_hash

# -----------------------------------------------------------------
# CONFIDENTIAL EMAIL & STORAGE SERVICES (AWS S3 & SendGrid)
# -----------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIA_CONFIDENTIAL_KEY_ID
AWS_SECRET_ACCESS_KEY=confidential_aws_secret_key_access_hash
AWS_S3_BUCKET_NAME=billmint-invoices-pdf-storage
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.confidential_sendgrid_api_key

# -----------------------------------------------------------------
# PUBLIC FRONTEND APPS API ENDPOINTS
# -----------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_DASHBOARD_URL=http://localhost:3001
VITE_ADMIN_URL=http://localhost:3002
VITE_LANDING_URL=http://localhost:3000
